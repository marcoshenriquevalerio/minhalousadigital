// Cole DENTRO de "match /databases/{database}/documents { ... }" das suas regras atuais.
match /directory/{u}  { allow read: if request.auth != null; allow write: if request.auth.uid == u; }
match /dirPhotos/{u}  { allow read: if request.auth != null; allow write: if request.auth.uid == u; }
match /blocks/{id} {
  allow read, delete: if request.auth.uid == resource.data.blocker;
  allow create: if request.auth.uid == request.resource.data.blocker
                && id == request.auth.uid + '_' + request.resource.data.blocked;
}
match /follows/{id} {
  allow read: if request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid;
  allow create: if request.auth.uid == request.resource.data.fromUid
    && request.resource.data.fromUid != request.resource.data.toUid
    && id == request.resource.data.fromUid + '_' + request.resource.data.toUid
    && request.resource.data.status == 'pending'
    && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.toUid + '_' + request.resource.data.fromUid))
    && get(/databases/$(database)/documents/directory/$(request.resource.data.toUid)).data.get('noRequests', false) == false;
  allow update: if request.auth.uid == resource.data.toUid && resource.data.status == 'pending'
    && request.resource.data.fromUid == resource.data.fromUid && request.resource.data.toUid == resource.data.toUid;
  allow delete: if request.auth.uid == resource.data.toUid
    || (request.auth.uid == resource.data.fromUid && resource.data.status != 'rejected');
}
